{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start loopback Modbus simulator",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--locked",
        "python",
        "-m",
        "backend.modbus_simulator",
        "--port",
        "1502"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "offline-simulator",
        "pattern": {
          "regexp": "^((?:\\w*Error|\\w*Exception): .*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Offline Modbus simulator listening",
          "endsPattern": "^Offline Modbus simulator listening"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
