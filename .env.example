# Lokale Vorlage; echte Zielwerte nur in der ignorierten Datei .env.
MODBUS_HOST=
MODBUS_PORT=502
MODBUS_UNIT_ID=255
REGISTER_PROFILE=core
COLLECTOR_ENABLED=false
# Optional finite run; when set, transport failures stop without retries.
COLLECTOR_MAX_REQUESTS=
DATA_DIR=./data
DISPLAY_TIMEZONE=Europe/Vienna
# Optional: Browser-Origin hinter dem Reverse-Proxy, z. B. https://monitor.example.invalid
PUBLIC_ORIGIN=
WEB_PORT=8000
DATA_PATH=./data
PUID=99
PGID=100
APP_VERSION=0.3.1
BUILD_REVISION=unknown
